name: CI
on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  tests:
    name: tests
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
      python-version: "3.13"
      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          if (Test-Path requirements.lock.txt) { pip install -r requirements.lock.txt } else { pip install -r requirements.txt }
          if (Test-Path .\requirements-dev.txt) { pip install -r requirements-dev.txt }
      - name: Run pytest
        run: |
          if (Test-Path .\tests) { pytest -q } else { echo "No tests dir — skipping"; exit 0 }

  mypy:
    name: mypy
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
      python-version: "3.13"
      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          if (Test-Path requirements.lock.txt) { pip install -r requirements.lock.txt } else { pip install -r requirements.txt }
          pip install mypy
      - name: Run mypy (tolerant default)
        run: |
          if (Test-Path .\mypy.ini) {
            mypy .
          } else {
            mypy --ignore-missing-imports .
          }



workflow_dispatch:
