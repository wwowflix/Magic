[CmdletBinding()]
param(
  [string]$Root = (Get-Location).Path,
  [int]$SamplePerModule = 2,
  [switch]$Strict,
  [switch]$RunOrchestratorIfMissing,
  [string]$PythonExe = "",
  [string]$SmokePattern = "",
  [int]$MaxPreview = 400
)

$ErrorActionPreference = 'Stop'

function New-Utf8NoBom { param([string]$Path,[string]$Content)
  $enc = [System.Text.UTF8Encoding]::new($false)
  $dir = Split-Path -Parent $Path
  if ($dir -and -not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
  [IO.File]::WriteAllText($Path,$Content,$enc)
}

function Out-Status { param([string]$Label,[string]$State,[string]$Note = "")
  $c = switch ($State) { 'PASS' {'Green'} 'WARN' {'Yellow'} default {'Red'} }
  "{0,-32} {1,-6} {2}" -f $Label, $State, $Note | Write-Host -ForegroundColor $c
}

function Run-Cmd { param([string]$Cmd,[switch]$Quiet)
  $psi = New-Object System.Diagnostics.ProcessStartInfo
  $psi.FileName = 'cmd.exe'
  $psi.Arguments = "/c $Cmd"
  $psi.RedirectStandardOutput = $true
  $psi.RedirectStandardError  = $true
  $psi.UseShellExecute = $false
  $psi.CreateNoWindow = $true
  $p = [Diagnostics.Process]::Start($psi)
  $out = $p.StandardOutput.ReadToEnd()
  $err = $p.StandardError.ReadToEnd()
  $p.WaitForExit()
  if (-not $Quiet) {
    if ($out) { Write-Host ($out.TrimEnd()) }
    if ($err) { Write-Host ($err.TrimEnd()) -ForegroundColor DarkYellow }
  }
  [pscustomobject]@{ ExitCode=$p.ExitCode; Stdout=$out; Stderr=$err }
}

function Resolve-Python { param([string]$Given)
  if ($Given -and (Test-Path $Given)) { return (Resolve-Path $Given).Path }
  $venvPy = Join-Path $Root "venv\Scripts\python.exe"
  if (Test-Path $venvPy) { return (Resolve-Path $venvPy).Path }
  return "python"
}

# --- preamble ---
$Root       = (Resolve-Path $Root).Path
Set-Location $Root
$now        = Get-Date
$stamp      = $now.ToString("yyyyMMdd_HHmmss")
$reportDir  = Join-Path $Root "outputs\reports"
$logDir     = Join-Path $Root "outputs\logs"
$summaryTsv = Join-Path $logDir "master_orchestrator_summary.tsv"
$python     = Resolve-Python -Given:$PythonExe

if (-not (Test-Path $reportDir)) { New-Item -ItemType Directory -Force -Path $reportDir | Out-Null }

$results = [System.Collections.Generic.List[object]]::new()
$modStats = @()
$fail = 0; $warn = 0

# 1) root & folders
$haveRoot = Test-Path $Root
$need = @("scripts","tools",".github","outputs")
$missing = @()
foreach($n in $need){ if(-not (Test-Path (Join-Path $Root $n))){ $missing += $n } }

if ($haveRoot -and $missing.Count -eq 0) {
  Out-Status "Root & folders" "PASS" $Root
  $results.Add([pscustomobject]@{key='root'; state='PASS'; note=$Root})
} elseif (-not $haveRoot) {
  Out-Status "Root & folders" "FAIL" ("Missing: " + $Root)
  $results.Add([pscustomobject]@{key='root'; state='FAIL'; note='missing root'})
  $fail++
} else {
  Out-Status "Root & folders" "WARN" ("Missing: " + ($missing -join ', '))
  $results.Add([pscustomobject]@{key='root'; state='WARN'; note=("missing: " + ($missing -join ', '))})
  $warn++
}

# 2) git branch / clean
$gitBranch = ''
$gitClean  = $false
try {
  $b = Run-Cmd "git rev-parse --abbrev-ref HEAD" -Quiet
  if ($b.ExitCode -eq 0) { $gitBranch = ($b.Stdout.Trim()) }
  $s = Run-Cmd "git status --porcelain" -Quiet
  $gitClean = [string]::IsNullOrWhiteSpace($s.Stdout)
  $note = "branch=$gitBranch; clean=$gitClean"
  $state = "WARN"
  if ($gitBranch -and $gitClean) { $state = "PASS" }
  if ($state -eq "WARN") { $warn++ }
  Out-Status "Git branch/clean" $state $note
  $results.Add([pscustomobject]@{key='git'; state=$state; note=$note})
} catch {
  Out-Status "Git" "WARN" "Not a repo?"
  $results.Add([pscustomobject]@{key='git'; state='WARN'; note='not a repo'})
  $warn++
}

# 3) Python info
try {
  $pv = Run-Cmd ("`"" + (Resolve-Path $python) + "`" --version") -Quiet
  $note = ($pv.Stdout + $pv.Stderr).Trim()
  if ($pv.ExitCode -eq 0) {
    Out-Status "Python" "PASS" $note
    $results.Add([pscustomobject]@{key='python'; state='PASS'; note=$note})
  } else {
    Out-Status "Python" "FAIL" $note
    $results.Add([pscustomobject]@{key='python'; state='FAIL'; note=$note})
    $fail++
  }
} catch {
  Out-Status "Python" "FAIL" "Failed to run"
  $results.Add([pscustomobject]@{key='python'; state='FAIL'; note='unavailable'})
  $fail++
}

# 4) Phase11 inventory + sample execution (uses & $python, not Start-Process)
$phase11 = Join-Path $Root "scripts\phase11"
if (Test-Path $phase11) {
  $mods = Get-ChildItem -LiteralPath $phase11 -Directory | Where-Object { $_.Name -like 'module_*' }
  if (-not $mods) {
    Out-Status "Phase11 modules" "WARN" "No module_* dirs"
    $results.Add([pscustomobject]@{key='phase11_modules'; state='WARN'; note='no module_*'})
    $warn++
  } else {
    foreach($m in $mods) {
      $ready = Get-ChildItem -LiteralPath $m.FullName -Recurse -Filter "*_READY.py"
      $modStats += [pscustomobject]@{ module=$m.Name; ready=$ready.Count }
    }
    $totalReady = 0
    if ($modStats.Count -gt 0) { $totalReady = ($modStats | Measure-Object -Property ready -Sum).Sum }
    $stateReady = "WARN"; if ($totalReady -gt 0) { $stateReady = "PASS" }
    $details = if ($modStats) { ($modStats | ForEach-Object {"$($_.module)=$($_.ready)"} ) -join '; ' } else { "none" }
    Out-Status "Phase11 READY count" $stateReady ("total=$totalReady; " + $details)
    $results.Add([pscustomobject]@{key='phase11_ready'; state=$stateReady; note=("total=" + $totalReady)})
    if ($stateReady -eq "WARN") { $warn++ }

    # sampler env
    if (-not $env:MPLBACKEND)              { $env:MPLBACKEND = "Agg" }
    if (-not $env:PYTHONIOENCODING)        { $env:PYTHONIOENCODING = "utf-8" }
    if (-not $env:PYTHONDONTWRITEBYTECODE) { $env:PYTHONDONTWRITEBYTECODE = "1" }
    if ([string]::IsNullOrWhiteSpace($env:PYTHONPATH)) { $env:PYTHONPATH = $Root } else { $env:PYTHONPATH = "$Root;$env:PYTHONPATH" }

    $accept  = @("OK","PASS","WARN")
    $badRuns = @()

    Push-Location $Root
    try {
      foreach($m in $mods) {
        $targets = Get-ChildItem -LiteralPath $m.FullName -Recurse -Filter "*_READY.py"
        if ($null -eq $targets -or $targets.Count -eq 0) { continue }

        if (-not [string]::IsNullOrEmpty($SmokePattern)) {
          $targets = $targets | Where-Object { Select-String -Path $_.FullName -Quiet -Pattern $SmokePattern }
        }

        $sample = $targets | Select-Object -First $SamplePerModule
        foreach($t in $sample) {
          $out = & $python -X faulthandler -u $t.FullName 2>&1
          $rc  = $LASTEXITCODE
          $joined = ""
          if ($out) { $joined = ($out -join "`n") }
          $okOut = $true
          if (-not [string]::IsNullOrWhiteSpace($joined)) {
            $okOut = ($accept | Where-Object { $joined -like ("*" + $_ + "*") }) -ne $null
          }
          if ($rc -ne 0 -or -not $okOut) {
            $preview = ""
            if ($joined) { $preview = $joined.Substring(0, [Math]::Min($MaxPreview, [Math]::Max(0,$joined.Length))) }
            $badRuns += [pscustomobject]@{ script=$t.FullName; rc=$rc; preview=$preview }
          }
        }
      }
    } finally { Pop-Location }

    if ($badRuns.Count -eq 0) {
      Out-Status "READY sample run" "PASS" ("samplePerModule=" + $SamplePerModule)
      $results.Add([pscustomobject]@{key='ready_sample'; state='PASS'; note=("samplePerModule=" + $SamplePerModule)})
    } else {
      $notes = ($badRuns | Select-Object -First 3 | ForEach-Object { "rc=$($_.rc) :: $($_.script)" }) -join " | "
      Out-Status "READY sample run" "FAIL" $notes
      $results.Add([pscustomobject]@{key='ready_sample'; state='FAIL'; note=($badRuns.Count.ToString() + " bad")})
      $fail++
    }
  }
} else {
  Out-Status "Phase11" "WARN" "Missing scripts\phase11"
  $results.Add([pscustomobject]@{key='phase11'; state='WARN'; note='missing'})
  $warn++
}

# 5) orchestrator TSV check
if (-not (Test-Path $summaryTsv) -and $RunOrchestratorIfMissing) {
  $orch = Join-Path $Root "tools\Magic_Orchestrator_Master_v3.ps1"
  if (Test-Path $orch) {
    Write-Host ">> Running orchestrator to produce summary TSV..." -ForegroundColor Cyan
    powershell -NoProfile -ExecutionPolicy Bypass -File $orch | Out-Null
  }
}
if (Test-Path $summaryTsv) {
  $lines = Get-Content -LiteralPath $summaryTsv -Raw | Select-String -Pattern ".*" -AllMatches | ForEach-Object { $_.Matches.Value }
  $bad = @()
  foreach($ln in $lines) {
    $cells = $ln -split "`t"
    if ($cells.Count -gt 0) {
      $last = $cells[-1].Trim()
      if ($last -in @('FAIL','ERROR')) { $bad += $ln }
    }
  }
  if ($bad.Count -eq 0) {
    Out-Status "Orchestrator summary" "PASS" (Split-Path $summaryTsv -Leaf)
    $results.Add([pscustomobject]@{key='orchestrator'; state='PASS'; note='no FAIL/ERROR'})
  } else {
    Out-Status "Orchestrator summary" "FAIL" ($bad.Count.ToString() + " failing rows")
    $results.Add([pscustomobject]@{key='orchestrator'; state='FAIL'; note=($bad.Count.ToString() + " failing rows")})
    $fail++
  }
} else {
  Out-Status "Orchestrator summary" "WARN" "TSV missing"
  $results.Add([pscustomobject]@{key='orchestrator'; state='WARN'; note='missing TSV'})
  $warn++
}

# 6) CI smoke workflow presence
$ciSmoke = Join-Path $Root ".github\workflows\smoke-phase11.yml"
if (Test-Path $ciSmoke) {
  Out-Status "CI smoke workflow" "PASS" (Split-Path $ciSmoke -Leaf)
  $results.Add([pscustomobject]@{key='ci_smoke'; state='PASS'; note='present'})
} else {
  Out-Status "CI smoke workflow" "WARN" "missing .github/workflows/smoke-phase11.yml"
  $results.Add([pscustomobject]@{key='ci_smoke'; state='WARN'; note='missing'})
  $warn++
}

# --- snapshot & exit ---
$state = 'PASS'
if ($fail -gt 0) { $state = 'FAIL' }
elseif ($Strict.IsPresent -and $warn -gt 0) { $state = 'FAIL' }
elseif ($warn -gt 0) { $state = 'WARN' }

$payload = [pscustomobject]@{
  timestamp = $now.ToString("o")
  root      = $Root
  state     = $state
  strict    = [bool]$Strict
  failCount = $fail
  warnCount = $warn
  facts     = $results
  phase11   = if ($modStats){ $modStats } else { @() }
}

$jsonPath = Join-Path $reportDir ("magic_status_snapshot_{0}.json" -f $stamp)
$tsvPath  = Join-Path $reportDir ("magic_status_snapshot_{0}.tsv"  -f $stamp)
New-Utf8NoBom $jsonPath ($payload | ConvertTo-Json -Depth 6)
$lines = @("key`tstate`tnote")
$lines += ($results | ForEach-Object { "{0}`t{1}`t{2}" -f $_.key,$_.state,($_.note -replace "`r?`n"," ") })
New-Utf8NoBom $tsvPath ($lines -join "`n")

Write-Host ""
Write-Host "Snapshot saved:" -ForegroundColor Cyan
Write-Host ("  JSON: " + $jsonPath)
Write-Host ("  TSV : " + $tsvPath)

switch ($state) { 'PASS' {exit 0} 'WARN' {exit 2} default {exit 1} }
