# Default: text files normalized to LF
*           text=auto eol=lf

# Windows PowerShell scripts should be CRLF (they often expect it)
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Batch files
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Keep archives/binaries untouched
*.zip       -text
*.tar       -text
*.tar.gz    -text
*.7z        -text
*.png       -text
*.jpg       -text
*.gif       -text
*.ico       -text
*.pdf       -text
