repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.6.9
    hooks:
      - id: ruff
        args: [--fix]
        files: ^(agents|tools|self_healing_runner_v5\.py)(/|\\)
        exclude: ^(backups|outputs|scripts|venv|clean_env|\.git|\.mypy_cache|\.ruff_cache)(/|\\)|_BACKUP_
      - id: ruff-format
        files: ^(agents|tools|self_healing_runner_v5\.py)(/|\\)
        exclude: ^(backups|outputs|scripts|venv|clean_env|\.git|\.mypy_cache|\.ruff_cache)(/|\\)|_BACKUP_

  - repo: https://github.com/psf/black
    rev: 24.8.0
    hooks:
      - id: black
        files: ^(agents|tools|self_healing_runner_v5\.py)(/|\\)
        exclude: ^(backups|outputs|scripts|venv|clean_env|\.git|\.mypy_cache|\.ruff_cache)(/|\\)|_BACKUP_

  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.11.2
    hooks:
      - id: mypy
        files: ^(agents|tools|self_healing_runner_v5\.py)(/|\\)
        exclude: ^(backups|outputs|scripts|venv|clean_env|\.git|\.mypy_cache|\.ruff_cache)(/|\\)|_BACKUP_
        additional_dependencies:
          - pandas-stubs
