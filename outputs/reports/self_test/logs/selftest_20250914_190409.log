  $rel = $f.FullName.Replace($Root,"").TrimStart("\","/")
  $hash = Hash-IfSmall -File $f -BytesCap $hashCapBytes
  $inventory += [pscustomobject]@{
    path         = $f.FullName
    rel_path     = $rel
    name         = $f.Name
    ext          = $f.Extension.ToLower()
    dir          = $f.DirectoryName
    size_bytes   = [long]$f.Length
    size_mb      = [math]::Round($f.Length/1MB,2)
    created_utc  = $f.CreationTimeUtc.ToString("s")
    modified_utc = $f.LastWriteTimeUtc.ToString("s")
